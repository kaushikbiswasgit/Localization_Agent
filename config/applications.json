
{
  "applicationName": "Resideo Connect",
  "applicationUrl": "https://pro.stage.resideo.com/",
  "sourceLanguage": "en",
  "sourceLanguageName": "English",
  "targetLanguages": [
    "es",
    "de"
  ],
  "testingScope": [
    "Dashboard"
  ],
  "authentication": {
    "mode": "manual"
  },
  "execution": {
    "captureEnglishBaseline": false,
    "compareTranslatedContent": true,
    "captureScreenshots": true,
    "reuseExistingBaseline": true,
    "sequentialExecution": true,
    "validateAfterEachLanguageChange": true,
    "generateConsolidatedReport": true
  },
  "baseline": {
    "filePath": "artifacts/baseline/english-baseline.json",
    "required": true,
    "sourceLanguage": "en",
    "approvalRequired": true,
    "regenerateAutomatically": false
  }
}
